{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SequenceTool",
  "version": "0.1.0",
  "identifier": "com.spritetools.seqtool",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "序列图工具",
        "width": 1100,
        "height": 720,
        "minWidth": 920,
        "minHeight": 620,
        "backgroundColor": "#202020"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
