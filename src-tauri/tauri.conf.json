{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "图像工具箱",
  "mainBinaryName": "图像工具箱",
  "version": "0.1.0",
  "identifier": "com.spritetools.seqtool",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File scripts\\download-deps.ps1"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "图像工具箱",
        "width": 1100,
        "height": 720,
        "minWidth": 1020,
        "minHeight": 750,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#202020"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/ffmpeg.exe", "resources/yt-dlp.exe"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
